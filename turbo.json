{
  "$schema": "https://turbo.build/schema.json",
  // The packages' tsconfig.json and typedoc.json extend these, but turbo hashes only the files inside a task's package.
  "globalDependencies": ["tsconfig.json", "typedoc.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "outputs": ["coverage/**"]
    }
  }
}
