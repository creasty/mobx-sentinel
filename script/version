#!/usr/bin/env bash
#> Usage: ./script/version
#>
#> Prints the version the packages agree on.
#>
#> Fails if they disagree, or if the version is not a plain X.Y.Z. Everything
#> downstream -- the `vX.Y.Z` tag, the release, the `latest` dist-tag -- assumes
#> one semver-valid number shared by all three packages, and the `workspace:~`
#> peer specifiers only resolve to a usable range when that holds. The semver
#> check doubles as the refusal of a `-dev-` tree: `script/bump dev` leaves a
#> prerelease version behind, and that must never reach the `latest` tag.

set -euo pipefail

do_help() {
  sed -n -E '/^#>/s/^#>[ ]?//p' < "$0"
  exit 1
}

if [ "${1:-}" != '' ]; then
  do_help
fi

versions="$(jq -r .version ./packages/*/package.json | sort -u)"

if [ "$(echo "$versions" | wc -l)" -ne 1 ]; then
  echo "packages disagree on the version:" >&2
  jq -r '"  \(input_filename): \(.version)"' ./packages/*/package.json >&2
  exit 1
fi

if ! echo "$versions" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "not a plain X.Y.Z version: $versions" >&2
  exit 1
fi

echo "$versions"
